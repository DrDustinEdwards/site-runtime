{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "@cloudflare/workers-types"]
  },
  "include": ["*.mjs", "members/*.mjs", "rate-limit/*.mjs", "bin/*.mjs"],
  "exclude": ["turnstile.mjs", "sign-in-client.mjs", "sites-values.mjs"]
}
