{
  "name": "@dustinedwards/site-runtime",
  "version": "0.3.0",
  "private": true,
  "description": "The portfolio sites' shared runtime. Today: OWASP Secure Headers Project defaults, a Content-Security-Policy built from a per-site list of what a site loads, the check a site runs in CI to prove its responses carry them, and one exact rate limiter on a SQLite Durable Object, and the members model: layers, permission bundles and end dates for an app with staff.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "default": "./index.mjs"
    },
    "./headers": {
      "types": "./headers.d.mts",
      "default": "./headers.mjs"
    },
    "./csp": {
      "types": "./csp.d.mts",
      "default": "./csp.mjs"
    },
    "./check": {
      "types": "./check.d.mts",
      "default": "./check.mjs"
    },
    "./oshp": {
      "types": "./oshp-suite.d.mts",
      "default": "./oshp-suite.mjs"
    },
    "./owasp": {
      "types": "./owasp-headers.d.mts",
      "default": "./owasp-headers.mjs"
    },
    "./rate-limit": {
      "types": "./rate-limit/index.d.mts",
      "default": "./rate-limit/index.mjs"
    },
    "./rate-limit/durable-object": {
      "types": "./rate-limit/durable-object.d.mts",
      "default": "./rate-limit/durable-object.mjs"
    },
    "./members": {
      "types": "./members/index.d.mts",
      "default": "./members/index.mjs"
    }
  },
  "bin": {
    "check-security-headers": "./bin/check-security-headers.mjs"
  },
  "files": [
    "index.mjs",
    "index.d.mts",
    "headers.mjs",
    "headers.d.mts",
    "csp.mjs",
    "csp.d.mts",
    "check.mjs",
    "check.d.mts",
    "oshp-suite.mjs",
    "oshp-suite.d.mts",
    "owasp-headers.mjs",
    "owasp-headers.d.mts",
    "oshp-tests-suite.yml",
    "update-owasp.mjs",
    "rate-limit",
    "members",
    "bin",
    "README.md"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "license": "UNLICENSED"
}
